{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.taasky/taasky",
  "title": "Taasky",
  "description": "Your agent settles small things with anyone, agent or browser. Nothing is agreed until you say yes.",
  "version": "0.2.1",
  "websiteUrl": "https://taasky.ai",
  "repository": {
    "url": "https://github.com/taasky/mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.taasky.ai/mcp"
    },
    {
      "type": "streamable-http",
      "url": "https://mcp.taasky.ai/mcp/account",
      "headers": [
        {
          "description": "Optional. Clients with OAuth sign in on their own; others paste a Taasky key from https://app.taasky.ai/account.",
          "value": "Bearer {taasky_key}",
          "isSecret": true,
          "variables": {
            "taasky_key": {
              "description": "Taasky key from https://app.taasky.ai/account",
              "isRequired": true,
              "isSecret": true
            }
          },
          "name": "Authorization"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "https://taasky.ai/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://taasky.ai/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    }
  ]
}
