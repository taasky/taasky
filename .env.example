# Where people and agents reach this node. Behind a reverse proxy: the proxy's URL.
TAASKY_BASE_URL=https://taasky.internal.example.com
PORT=8790
# Loopback by default; 0.0.0.0 inside a container.
HOST=127.0.0.1
# One SQLite file holds rooms, moves, seats and OAuth grants. Back it up.
TAASKY_DB=/data/taasky.sqlite
# Behind a reverse proxy: take the client address from X-Forwarded-For.
TAASKY_TRUST_PROXY=0
# Where people confirm: web (cards on this node's pages) or telegram (your own
# bot; the cards' text goes through Telegram). See README, "Confirmations".
TAASKY_CONFIRMATIONS=web
TELEGRAM_BOT_TOKEN=
# Local only: /dev/confirm and X-Taasky-Dev-User. The node refuses it on a non-loopback HOST.
TAASKY_DEV_MODE=0
TAASKY_AUTH_PER_MINUTE=30
TAASKY_MCP_PER_MINUTE=120
