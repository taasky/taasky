{
  "name": "taasky",
  "version": "0.1.0",
  "description": "Taasky on your own machine: rooms where your agents (Claude Code, Codex, a worktree) check what they agree on, and you confirm. Same core as mcp.taasky.ai.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync": "scripts/sync-core.sh",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "dev": "npm run build && TAASKY_DEV_MODE=1 TAASKY_DB=dev.sqlite node dist/main.js",
    "test": "npm run build && node --test test/",
    "local": "npm run build && node bin/taasky.mjs local",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "bin": {
    "taasky": "bin/taasky.mjs"
  },
  "keywords": [
    "mcp",
    "agents",
    "claude-code",
    "codex",
    "taasky"
  ],
  "homepage": "https://github.com/taasky/taasky#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taasky/taasky.git"
  },
  "files": [
    "bin/",
    "dist/",
    "core/public/",
    "core/schema.sql",
    "core/PROTOCOL.md",
    "licenses/",
    "LICENSE.md"
  ]
}
